# ─────────────────────────────────────────────────────────────────────────────
# .streamlit/secrets.toml  (copy this file to secrets.toml for local dev,
#  or paste these key=value pairs into Streamlit Cloud → App settings → Secrets)
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — powers RAG answer generation, Run Evaluation, and the RAG Debugger
# (used as the RAGAS judge too). Free key: https://console.groq.com/keys
GROQ_API_KEY = "gsk_..."

# Google OAuth
# From: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID     = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "YOUR_GOOGLE_CLIENT_SECRET"

# GitHub OAuth
# From: github.com → Settings → Developer settings → OAuth Apps → Your App
GITHUB_CLIENT_ID     = "YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET = "YOUR_GITHUB_CLIENT_SECRET"

# CRITICAL: must match EXACTLY what you put in Google Console & GitHub OAuth app
# For production (Streamlit Cloud):
OAUTH_REDIRECT_URI = "https://ai-evals-trustllm-upgrade.streamlit.app"

# For local dev, override with:
# OAUTH_REDIRECT_URI = "http://localhost:8501"

# Supabase (optional — only needed if you enable Supabase auth features)
# From: supabase.com → Project Settings → API
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-anon-public-key"
